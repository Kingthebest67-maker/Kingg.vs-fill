local function SetUIScale(scale)
	CurrentScale = scale
	Config.Scale = scale
	local newWidth = math.floor(OriginalSize.X * scale)
	local newHeight = math.floor(OriginalSize.Y * scale)
	
	TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {
		Size = UDim2.new(0, newWidth, 0, newHeight),
		Position = UDim2.new(0.5, -newWidth/2, 0.5, -newHeight/2)
	}):Play()
	
	if Config.AutoSave then SaveConfig() end
end

