				end
			end
			b.BackgroundColor3 = Color3.fromRGB(240, 240, 250)
			b.TextColor3 = Color3.fromRGB(20, 20, 30)
		end)
	end

	ContentContainer.CanvasSize = UDim2.new(0, 0, 0, y + 60)
end

local function SelectTab(name)
	for tabName, data in pairs(TabButtons) do
		if tabName == name then
			data.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
			data.Indicator.Visible = true
		else
			data.Button.TextColor3 = Color3.fromRGB(140, 140, 155)
			data.Indicator.Visible = false
		end
	end
	if name == "Speed" then LoadSpeed()
	elseif name == "Combat" then LoadCombat()
	elseif name == "Steal" then LoadSteal()
	elseif name == "Visual" then LoadVisual()
	elseif name == "Interface" then LoadInterface()
	end
end

for name, data in pairs(TabButtons) do
	data.Button.MouseButton1Click:Connect(function()
		SelectTab(name)
	end)
end

SelectTab("Speed")

-- Dragging
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Open / Minimize
OpenBtn.MouseButton1Click:Connect(function()
	Main.Visible = true
	OpenBtn.Visible = false
end)

MinBtn.MouseButton1Click:Connect(function()
	Main.Visible = false
	OpenBtn.Visible = true
end)

